# Local development. On Render these are set from the dashboard / render.yaml.
DATABASE_URL=postgres://user:password@localhost:5432/asa
PORT=3001

# Bootstrap account, created only when the users table is empty.
# Without SEED_ADMIN_PASSWORD a random one is generated and printed to the log once.
SEED_ADMIN_EMAIL=admitting@nairobihospital.org
SEED_ADMIN_NAME=Registry Admin
SEED_ADMIN_PASSWORD=

# Set to "production" so the session cookie carries the Secure flag.
NODE_ENV=development
