# Local development. On Render these are set from the dashboard / render.yaml.
DATABASE_URL=postgres://user:password@localhost:5432/asa
PORT=3001

# Bootstrap account, created only when the users table is empty.
# Without SEED_ADMIN_PASSWORD a random one is generated and printed to the log once.
SEED_ADMIN_EMAIL=admitting@nairobihospital.org
SEED_ADMIN_NAME=Registry Admin
SEED_ADMIN_PASSWORD=

# Set to "production" so the session cookie carries the Secure flag.
NODE_ENV=development

# Recovery hatch. With ADMIN_PASSWORD_RESET=true the admin account is put back
# to SEED_ADMIN_PASSWORD on the next boot, even on a registry that already has
# users — the way back in when the bootstrap password was never captured and
# the database takes no external connections. With exactly one account,
# SEED_ADMIN_EMAIL also corrects the sign-in address. Remove both once you are
# in; a live password should not sit in the service environment.
ADMIN_PASSWORD_RESET=
