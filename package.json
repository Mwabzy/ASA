{
  "name": "nairobi-hospital-admitting-rights-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Admitting Rights Registry — The Nairobi Hospital",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node --watch --env-file-if-exists=.env server/index.js\"",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node --env-file-if-exists=.env server/index.js",
    "migrate": "node --env-file-if-exists=.env server/migrate.js"
  },
  "//": "The build toolchain sits in dependencies, not devDependencies: the host builds with NODE_ENV=production, where npm ci skips devDependencies and `vite` would not be found.",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.1.0",
    "compression": "^1.8.0",
    "express": "^5.2.1",
    "motion": "^13.2.0",
    "pg": "^8.23.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "shadcn": "^4.21.0"
  }
}
